<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- brand and tabs, fixed at the top -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/brand"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="22sp"
                    android:textStyle="bold" />
                <TextView style="@style/Hint" android:text="@string/ui_record_and_transform_your_voice_on_your" />
            </LinearLayout>
            <TextView
                android:id="@+id/status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/chip"
                android:paddingStart="10dp"
                android:paddingTop="4dp"
                android:paddingEnd="10dp"
                android:paddingBottom="4dp"
                android:textColor="@color/green"
                android:textSize="12sp" />
            <TextView
                android:id="@+id/gear"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/circle"
                android:contentDescription="@string/ui_settings"
                android:gravity="center"
                android:text="⚙"
                android:textColor="@color/accent_strong"
                android:textSize="19sp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/tabbar"
            android:orientation="horizontal"
            android:padding="4dp">
            <TextView
                android:id="@+id/tab_record"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/tab"
                android:gravity="center"
                android:text="@string/ui_record"
                android:textColor="@color/tab_text"
                android:textSize="14sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/tab_convert"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/tab"
                android:gravity="center"
                android:text="@string/ui_convert_2"
                android:textColor="@color/tab_text"
                android:textSize="14sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/tab_live"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/tab"
                android:gravity="center"
                android:text="@string/ui_live_4"
                android:textColor="@color/tab_text"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <!-- ======== record page ======== -->
            <LinearLayout
                android:id="@+id/page_record"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <LinearLayout style="@style/Card">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <TextView
                            android:id="@+id/rec_title"
                            style="@style/CardTitle"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@string/ui_new_recording" />
                        <TextView
                            android:id="@+id/rec_time"
                            style="@style/SliderValue"
                            android:text="0:00.0" />
                    </LinearLayout>
                    <com.voicestudio.phone.WaveformView
                        android:id="@+id/rec_wave"
                        android:layout_width="match_parent"
                        android:layout_height="150dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/wave_bg" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:gravity="center"
                        android:orientation="horizontal">
                        <Button
                            android:id="@+id/rec_rewind"
                            style="@style/SoftButton"
                            android:layout_width="56dp"
                            android:layout_height="48dp"
                            android:enabled="false"
                            android:text="⏮" />
                        <FrameLayout
                            android:id="@+id/record"
                            android:layout_width="76dp"
                            android:layout_height="76dp"
                            android:layout_marginStart="22dp"
                            android:layout_marginEnd="22dp"
                            android:background="@drawable/rec_outer"
                            android:clickable="true"
                            android:contentDescription="@string/ui_record"
                            android:focusable="true">
                            <View
                                android:id="@+id/record_dot"
                                android:layout_width="30dp"
                                android:layout_height="30dp"
                                android:layout_gravity="center"
                                android:background="@drawable/rec_dot" />
                        </FrameLayout>
                        <Button
                            android:id="@+id/rec_play"
                            style="@style/SoftButton"
                            android:layout_width="56dp"
                            android:layout_height="48dp"
                            android:enabled="false"
                            android:text="▶" />
                    </LinearLayout>
                    <TextView
                        android:id="@+id/rec_info"
                        style="@style/Hint"
                        android:layout_width="match_parent"
                        android:layout_marginTop="12dp"
                        android:gravity="center"
                        android:text="@string/ui_tap_the_red_button_to_start_recording" />
                </LinearLayout>
                <Button
                    android:id="@+id/to_convert"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/btn_primary"
                    android:enabled="false"
                    android:stateListAnimator="@null"
                    android:text="@string/ui_convert_this_recording"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />
                <LinearLayout style="@style/Card">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="bottom"
                        android:orientation="horizontal">
                        <TextView style="@style/CardTitle" android:text="@string/ui_recordings" />
                        <TextView
                            style="@style/Hint"
                            android:layout_marginStart="10dp"
                            android:text="@string/ui_tap_to_open_hold_to_delete" />
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/rec_list"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="vertical" />
                </LinearLayout>
            </LinearLayout>

            <!-- ======== live page: the microphone converted into the earphones ======== -->
            <LinearLayout
                android:id="@+id/page_live"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">
                <LinearLayout style="@style/Card">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <TextView
                            style="@style/CardTitle"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="@string/ui_live_conversion" />
                        <TextView
                            android:id="@+id/live_rec_time"
                            style="@style/SliderValue"
                            android:layout_marginEnd="8dp"
                            android:textColor="@color/rec"
                            android:visibility="gone" />
                        <Button
                            android:id="@+id/live_rec"
                            style="@style/SoftButton"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:layout_marginEnd="8dp"
                            android:enabled="false"
                            android:text="@string/ui_record_2" />
                        <Button
                            android:id="@+id/live_toggle"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:background="@drawable/btn_primary"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            android:paddingStart="20dp"
                            android:paddingEnd="20dp"
                            android:stateListAnimator="@null"
                            android:text="@string/ui_start"
                            android:textAllCaps="false"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                    <TextView
                        android:id="@+id/live_device"
                        style="@style/Hint"
                        android:layout_width="match_parent"
                        android:layout_marginTop="4dp" />
                    <com.voicestudio.phone.WaveformView
                        android:id="@+id/live_in_wave"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/wave_bg" />
                    <com.voicestudio.phone.WaveformView
                        android:id="@+id/live_out_wave"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/wave_bg" />
                    <TextView
                        android:id="@+id/live_stats"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:fontFamily="monospace"
                        android:lineSpacingExtra="2dp"
                        android:textColor="@color/text"
                        android:textSize="12sp" />
                    <TextView
                        android:id="@+id/live_info"
                        style="@style/Hint"
                        android:layout_width="match_parent"
                        android:layout_marginTop="6dp"
                        android:text="@string/ui_use_headphones_without_headphones_audio_plays_through" />
                </LinearLayout>
            </LinearLayout>

            <!-- ======== settings (the gear at the top): voice models, where the models run, records ======== -->
            <LinearLayout
                android:id="@+id/page_settings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/ui_settings"
                        android:textSize="20sp"
                        android:textStyle="bold" />
                    <Button
                        android:id="@+id/settings_close"
                        style="@style/SoftButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="@string/ui_close" />
                </LinearLayout>
                <LinearLayout style="@style/Card">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <TextView
                            style="@style/CardTitle"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="@string/ui_voice_model_2" />
                        <Button
                            android:id="@+id/import_model"
                            style="@style/SoftButton"
                            android:layout_width="wrap_content"
                            android:layout_height="34dp"
                            android:text="@string/ui_import" />
                    </LinearLayout>
                    <Spinner
                        android:id="@+id/model"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/spinner"
                        android:popupBackground="@drawable/card" />
                    <!-- the shared models, downloaded once (shown only while they are missing) -->
                    <LinearLayout
                        android:id="@+id/common_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:visibility="gone">
                        <TextView
                            android:id="@+id/common_text"
                            style="@style/Hint"
                            android:layout_width="0dp"
                            android:layout_weight="1" />
                        <Button
                            android:id="@+id/get_common"
                            style="@style/SoftButton"
                            android:layout_width="wrap_content"
                            android:layout_height="34dp"
                            android:text="@string/ui_download" />
                    </LinearLayout>
                    <ProgressBar
                        android:id="@+id/common_progress"
                        style="@android:style/Widget.ProgressBar.Horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="6dp"
                        android:layout_marginTop="8dp"
                        android:max="1000"
                        android:progressDrawable="@drawable/meter"
                        android:visibility="gone" />
                    <TextView
                        android:id="@+id/help"
                        style="@style/Hint"
                        android:layout_width="match_parent"
                        android:layout_marginTop="10dp"
                        android:lineSpacingExtra="2dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- ======== convert page ======== -->
            <LinearLayout
                android:id="@+id/page_convert"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">
                <LinearLayout style="@style/Card">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="bottom"
                        android:orientation="horizontal">
                        <TextView style="@style/CardTitle" android:text="@string/ui_pitch_texture" />
                        <TextView
                            style="@style/Hint"
                            android:layout_marginStart="10dp"
                            android:id="@+id/voice_hint"
                            android:text="@string/ui_saved_separately_for_each_model" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/ui_pitch"
                                android:textSize="13sp" />
                            <TextView style="@style/Hint" android:text="@string/ui_raise_or_lower_your_voice_semitones_octave" />
                        </LinearLayout>
                        <TextView android:id="@+id/pitch_value" style="@style/SliderValue" />
                    </LinearLayout>
                    <SeekBar android:id="@+id/pitch" style="@style/Slider" android:max="48" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <TextView style="@style/Scale" android:text="@string/ui_lower" />
                        <TextView style="@style/Scale" android:gravity="center" android:text="@string/ui_original_3" />
                        <TextView style="@style/Scale" android:gravity="end" android:text="@string/ui_higher" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <TextView style="@style/SliderLabel" android:text="@string/ui_formant_voice_texture" />
                        <TextView android:id="@+id/formant_value" style="@style/SliderValue" />
                    </LinearLayout>
                    <SeekBar android:id="@+id/formant" style="@style/Slider" android:max="40" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <TextView style="@style/Scale" android:text="−2" />
                        <TextView style="@style/Scale" android:gravity="end" android:text="+2" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/ui_normalize_volume"
                                android:textSize="13sp" />
                            <TextView style="@style/Hint" android:text="@string/ui_boost_quiet_recordings_to_a_suitable_output" />
                        </LinearLayout>
                        <Switch
                            android:id="@+id/normalize"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true" />
                    </LinearLayout>
                </LinearLayout>

                <!-- original -->
                <LinearLayout style="@style/Card">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <TextView
                            android:id="@+id/in_title"
                            style="@style/CardTitle"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@string/ui_original_4" />
                        <Button
                            android:id="@+id/pick"
                            style="@style/SoftButton"
                            android:layout_width="wrap_content"
                            android:layout_height="34dp"
                            android:text="@string/ui_choose_file" />
                    </LinearLayout>
                    <com.voicestudio.phone.WaveformView
                        android:id="@+id/in_wave"
                        android:layout_width="match_parent"
                        android:layout_height="84dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/wave_bg" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <Button
                            android:id="@+id/in_play"
                            style="@style/SoftButton"
                            android:layout_width="52dp"
                            android:layout_height="36dp"
                            android:enabled="false"
                            android:text="▶" />
                        <TextView
                            android:id="@+id/in_time"
                            style="@style/SliderValue"
                            android:layout_marginStart="10dp"
                            android:textSize="12sp" />
                        <TextView
                            android:id="@+id/in_info"
                            style="@style/Hint"
                            android:layout_width="0dp"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:gravity="end"
                            android:text="@string/ui_send_a_recording_from_the_record_tab" />
                    </LinearLayout>
                </LinearLayout>

                <Button
                    android:id="@+id/convert"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/btn_primary"
                    android:enabled="false"
                    android:stateListAnimator="@null"
                    android:text="@string/ui_convert"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />
                <ProgressBar
                    android:id="@+id/progress"
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:layout_marginTop="8dp"
                    android:progressDrawable="@drawable/meter"
                    android:visibility="gone" />

                <!-- result -->
                <LinearLayout
                    android:id="@+id/result"
                    style="@style/Card"
                    android:visibility="gone">
                    <TextView
                        android:id="@+id/out_title"
                        style="@style/CardTitle"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/ui_converted_audio" />
                    <com.voicestudio.phone.WaveformView
                        android:id="@+id/out_wave"
                        android:layout_width="match_parent"
                        android:layout_height="84dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/wave_bg" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <Button
                            android:id="@+id/out_play"
                            style="@style/SoftButton"
                            android:layout_width="52dp"
                            android:layout_height="36dp"
                            android:text="▶" />
                        <TextView
                            android:id="@+id/out_time"
                            style="@style/SliderValue"
                            android:layout_marginStart="10dp"
                            android:textSize="12sp" />
                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1" />
                        <Button
                            android:id="@+id/save"
                            style="@style/SoftButton"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:text="@string/ui_save" />
                        <Button
                            android:id="@+id/share"
                            style="@style/SoftButton"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:layout_marginStart="8dp"
                            android:text="@string/ui_share" />
                    </LinearLayout>
                    <TextView
                        android:id="@+id/out_info"
                        style="@style/Hint"
                        android:layout_marginTop="6dp" />
                </LinearLayout>

            </LinearLayout>
        </FrameLayout>
    </ScrollView>
</LinearLayout>
